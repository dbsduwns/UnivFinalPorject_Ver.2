# Supabase: use the Session Pooler connection string and require TLS.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Application secrets
SECRET_KEY=replace_with_a_long_random_secret
GOOGLE_API_KEY=replace_with_your_gemini_api_key

# Cloud Run AI configuration
GEMINI_MODEL=gemini-flash-latest
EMBEDDING_PROVIDER=google
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=https://replace-with-your-cluster-url
QDRANT_API_KEY=replace_with_your_qdrant_api_key
QDRANT_COLLECTION=knu-campus

# Optional crawler credentials
KNU_USER_ID=
KNU_PASSWORD=

# Mobile deep-link configuration
APP_SCHEME=knu
APP_DOWNLOAD_URL=
