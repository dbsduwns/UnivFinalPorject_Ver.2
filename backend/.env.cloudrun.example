# Supabase: use the Session Pooler connection string and require TLS.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key
SUPABASE_STORAGE_BUCKET=community-images

# Application secrets
SECRET_KEY=replace_with_a_long_random_secret
CLOUDFLARE_API_TOKEN=replace_with_your_workers_ai_token
CLOUDFLARE_ACCOUNT_ID=replace_with_your_cloudflare_account_id

# Cloud Run AI configuration
LLM_PROVIDER=cloudflare
EMBEDDING_PROVIDER=cloudflare
CLOUDFLARE_CHAT_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-m3
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=https://replace-with-your-cluster-url
QDRANT_API_KEY=replace_with_your_qdrant_api_key
QDRANT_COLLECTION=knu-campus-bge-m3

# 관리자 웹에서 수동으로 공지 전용 Cloud Run Job 실행
GCP_PROJECT_ID=your-google-cloud-project-id
GCP_REGION=asia-northeast3
NOTICE_CRAWLER_JOB=notice-crawler

# Optional crawler credentials
KNU_USER_ID=
KNU_PASSWORD=
MENU_OCR_LANG=kor+eng

# Mobile deep-link configuration
APP_SCHEME=knu
APP_DOWNLOAD_URL=

# Commute prediction / optional real-time providers (activate their products first).
GOOGLE_MAPS_SERVER_API_KEY=
PUBLIC_API_KEY=
# Requires Seoul route, arrival, and bus-position service approval.
SEOUL_BUS_API_KEY=
# 서울 지하철의 정적 역 목록 및 실시간 열차 위치 API 키입니다.
SEOUL_SUBWAY_API_KEY=
SEOUL_SUBWAY_REALTIME_API_KEY=
# Requires Gyeonggi route and arrival service approval.
GYEONGGI_BUS_API_KEY=
# These counters/caches are per process. Use one instance or add a shared cache.
SEOUL_BUS_DAILY_LIMIT=900
GYEONGGI_BUS_DAILY_LIMIT=900
TAGO_BUS_DAILY_LIMIT=9000
