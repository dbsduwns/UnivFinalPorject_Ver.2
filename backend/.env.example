# Database configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# KNU Portal Credentials (for crawling)
KNU_USER_ID=your_student_id
KNU_PASSWORD=your_password

# AI / Gemini API Key
GOOGLE_API_KEY=your_google_api_key_here

# Commute: prediction uses Google only. Live APIs run when a stop list is expanded.
GOOGLE_MAPS_SERVER_API_KEY=
PUBLIC_API_KEY=
# Opt in after activating each service at data.go.kr. The key may equal PUBLIC_API_KEY.
# Seoul requires route, arrival, and bus-position service approval.
# Gyeonggi requires route and arrival service approval; GPS coordinates are not exposed.
# Seoul: route information + arrival information; GBIS: bus route + bus arrival v2.
SEOUL_BUS_API_KEY=
# 서울시 실시간 지하철 열차 위치 API의 전용 인증키입니다.
SEOUL_SUBWAY_API_KEY=
SEOUL_SUBWAY_REALTIME_API_KEY=
GYEONGGI_BUS_API_KEY=
# Per-process, per-service safety budgets. Leave headroom for other API consumers.
SEOUL_BUS_DAILY_LIMIT=900
GYEONGGI_BUS_DAILY_LIMIT=900
TAGO_BUS_DAILY_LIMIT=9000
