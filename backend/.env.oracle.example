# Public API hostname. Point this hostname's A record to the Oracle VM public IP.
DOMAIN=api.example.com

# PostgreSQL container
POSTGRES_DB=knudb
POSTGRES_USER=knu_app
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Keep this password URL-encoded if it contains reserved URL characters.
DATABASE_URL=postgresql://knu_app:replace_with_a_long_random_password@db:5432/knudb

# Application secrets
SECRET_KEY=replace_with_a_long_random_secret
GOOGLE_API_KEY=replace_with_your_gemini_api_key
KNU_USER_ID=replace_with_portal_id
KNU_PASSWORD=replace_with_portal_password
APP_SCHEME=knu
APP_DOWNLOAD_URL=
