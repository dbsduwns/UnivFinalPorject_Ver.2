# Backend specific ignores
__pycache__/
*.py[cod]
.env
.env.oracle
.env.cloudrun
venv/
.venv/
.venv-migration/

# Database
*.db
*.sqlite3
*.dump
backups/
chroma_db/

# Static data (if generated by crawlers)
static/shuttle/*.pdf
*.jpg
*.png
data/*.html
!data/*.json

# OpenTripPlanner generated data and downloaded routing inputs
otp/*.jar
otp/*.pbf
otp/*.zip
otp/graph.obj
otp/otp-config.json
otp/build-config.json
otp/router-config.json
otp/logs/
