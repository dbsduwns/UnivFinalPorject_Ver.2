# 백엔드 API 베이스 URL (끝 슬래시 없이)
#
# ⛔ 클라이언트 주소로 http://0.0.0.0 은 쓰지 마세요. (서버 "수신" 전용이며, 폰에서 붙는 주소가 아님)
# 실제 폰(Expo Go) + PC API: PC의 Wi-Fi IP 사용 → ipconfig에서 IPv4 주소 확인
#   예: EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
# PC에서 uvicorn은 --host 0.0.0.0 으로 떠 있어야 같은 Wi-Fi의 폰에서 접속 가능
#
# Android 에뮬레이터만: http://10.0.2.2:8000
#
# EXPO_PUBLIC_ 접두사 필수
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
